<?xml version="1.0"?>
<sdf version="1.9">
  <world name="aegis_landslide_zone">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Core Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Multi-spectral LWIR thermal plugin for per-object radiation -->
    <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

    <!-- Atmospheric Lighting: Stormy Mountain Sun -->
    <light type="directional" name="sunUTC">
      <pose>20 30 50 0 0 0</pose>
      <diffuse>0.85 0.82 0.78 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.3 -0.4 -0.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Valley Bedrock Ground Plane (Ambient 295K) -->
    <model name="valley_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>140 140</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>140 140</size></plane></geometry>
          <material>
            <ambient>0.25 0.22 0.18 1</ambient>
            <diffuse>0.28 0.24 0.20 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>295</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Mountain Escarpment (Crown Scarp failure slope) -->
    <model name="crown_scarp_ridge">
      <static>true</static>
      <pose>18 0 10 0 0.35 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 60 18</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 60 18</size></box></geometry>
          <material>
            <ambient>0.35 0.32 0.28 1</ambient>
            <diffuse>0.40 0.36 0.32 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>296</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Landslide Debris Mounds (Humocky mud deposit) -->
    <model name="debris_tongue_mound">
      <static>true</static>
      <pose>-4 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>22 36 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22 36 4</size></box></geometry>
          <material>
            <ambient>0.22 0.17 0.12 1</ambient>
            <diffuse>0.25 0.19 0.14 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>294</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Sheared Mountain Highway (Cracked asphalt slab) -->
    <model name="highway_shear_slab">
      <static>true</static>
      <pose>-8 -14 1.2 0.2 0.1 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 12 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 12 0.3</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.18 0.19 0.20 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>298</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- PRIMARY VICTIM (Body temperature: 310K ~ 36.85°C) -->
    <model name="victim_primary">
      <static>true</static>
      <pose>3.5 1.5 0.25 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><capsule><radius>0.2</radius><length>1.6</length></capsule></geometry>
        </collision>
        <visual name="visual">
          <geometry><capsule><radius>0.2</radius><length>1.6</length></capsule></geometry>
          <material>
            <ambient>0.5 0.35 0.25 1</ambient>
            <diffuse>0.6 0.45 0.35 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>310</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- SECONDARY OCCLUDED VICTIM (Body temperature: 309K) -->
    <model name="victim_occluded">
      <static>true</static>
      <pose>-7 -9 0.25 0.2 0 1.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><capsule><radius>0.18</radius><length>1.5</length></capsule></geometry>
        </collision>
        <visual name="visual">
          <geometry><capsule><radius>0.18</radius><length>1.5</length></capsule></geometry>
          <material>
            <ambient>0.45 0.32 0.22 1</ambient>
            <diffuse>0.55 0.40 0.30 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>309</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- THERMAL FALSE POSITIVE: Sun-warmed granite rock (305K ~ 31.8°C) -->
    <model name="warm_rock_false_positive">
      <static>true</static>
      <pose>4 -8 0.6 0.2 0.3 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 1.8 1.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 1.8 1.4</size></box></geometry>
          <material>
            <ambient>0.35 0.32 0.28 1</ambient>
            <diffuse>0.42 0.38 0.34 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>305</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- DISASTER HAZARD: High-Voltage Arcing Power Line (315K short circuit) -->
    <model name="downed_power_line">
      <static>true</static>
      <pose>-6 -12 0.1 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>6.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>6.0</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>315</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- DISASTER HAZARD: Ruptured Fuel Line Combustion (873K ~ 600°C) -->
    <model name="fire_combustion_hazard">
      <static>true</static>
      <pose>-1 -6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.25 0.05 1</ambient>
            <diffuse>0.95 0.3 0.1 1</diffuse>
            <emissive>0.9 0.3 0.05 1</emissive>
          </material>
          <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::Thermal">
            <temperature>873</temperature>
          </plugin>
        </visual>
      </link>
    </model>

  </world>
</sdf>
